{
  "manifest_version": 3,
  "name": "Intentional",
  "version": "0.1",
  "description": "Reports the active tab's site to Intentional's desktop guard, and keeps over-budget sites out until tomorrow.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
